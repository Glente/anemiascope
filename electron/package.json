{
  "name": "anemiascope-desktop",
  "productName": "Anemiascope",
  "version": "1.0.0",
  "description": "Anemiascope desktop app",
  "author": "Anemiascope",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win msi --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dk.anemiascope.desktop",
    "productName": "Anemiascope",
    "files": ["main.cjs"],
    "directories": { "output": "release" },
    "win": { "target": ["msi"] },
    "msi": {
      "perMachine": false,
      "oneClick": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
